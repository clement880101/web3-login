{
  "name": "@clement.chang.dev/web3-login",
  "version": "2.0.0",
  "description": "React button for connecting an EIP-1193 wallet. No dependencies.",
  "keywords": [
    "web3",
    "wallet",
    "react",
    "ethereum",
    "eip-1193",
    "metamask"
  ],
  "homepage": "https://clement880101.github.io/web3-login",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clement880101/web3-login.git"
  },
  "license": "MIT",
  "author": "clementc",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
